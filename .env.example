# Copy to .env before customizing: cp .env.example .env
# The launcher creates/updates .env automatically and preserves other settings.
# See docs/configuration.md for details. Restart/recreate the service after changes.

# Host download folder. The launcher replaces this with Downloads/VesperTape.
# Quote paths containing spaces. Use a dedicated folder: initialization sets ownership.
VESPERTAPE_HOST_DOWNLOAD_DIR=./downloads

# App address: http://localhost:8000. Keep localhost binding for local use.
VESPERTAPE_BIND_ADDRESS=127.0.0.1
VESPERTAPE_API_PORT=8000

# Container user/group. The launcher replaces these with your UID/GID on Linux.
VESPERTAPE_UID=10001
VESPERTAPE_GID=10001

# Concurrent downloads. One worker avoids overlapping shared-archive downloads.
VESPERTAPE_WORKER_COUNT=1

# Allowed UI options, as JSON arrays. First entries become the defaults.
VESPERTAPE_ALLOWED_MODES='["video","audio"]'
VESPERTAPE_ALLOWED_QUALITIES='["best","1080p","720p","480p"]'
VESPERTAPE_ALLOWED_FORMATS='["auto","mp4","webm","mp3","m4a","flac","wav"]'

# Optional single-user password; blank disables authentication.
# Set a unique password of at least 16 characters. Username: vespertape.
# Single-quote passwords containing $ to avoid Compose interpolation.
VESPERTAPE_ACCESS_PASSWORD=

# Optional protected Netscape cookie file on the host (absolute path).
# Uncomment and set a real path, then use both Compose files:
# docker compose -f docker-compose.yml -f docker-compose.cookies.yml up --build -d
# VESPERTAPE_HOST_COOKIE_FILE='/absolute/path/to/cookies.txt'

# Local API execution only: export these in your shell if needed.
# The local API does not load .env automatically. Compose uses /data and
# /downloads internally; its cookie override sets the container cookie path.
# Changing container storage paths also requires corresponding volume mounts.
# VESPERTAPE_DATA_DIR=data
# VESPERTAPE_DOWNLOAD_DIR=data/downloads
# VESPERTAPE_COOKIE_FILE='/absolute/path/to/cookies.txt'

# Prebuilt deployment only: docker compose -f docker-compose.image.yml up -d
# Pin a published sha-<full-commit> tag or @sha256:<digest> for a fixed version.
VESPERTAPE_IMAGE=ghcr.io/khawarmehfooz/vespertape:latest
